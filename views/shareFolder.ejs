<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentFolder.name || "Root" %></title>
</head>
<body> 
    <%# Only show back button for items that are not root folder%>
    <% if (locals.currentFolder && currentFolder.id !== share.folderId) {%>
        <a href="/share/<%= share.token %><%= currentFolder.parentId !== locals.share.folderId ? `/folder/${currentFolder.parentId}` : ""%>">Back</a>
     <% } %>   

    <% if (locals.content.length > 0) {%>
        <%- include("./partials/shareBrowser")%>
    <% } else {%>
        <p>No items in this folder.</p>
    <% } %>
</body>
</html>