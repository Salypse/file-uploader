<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/styles/root.css">
    <link rel="Stylesheet" href="/styles/navbar.css">

    <title><%= currentFolder.name || "Root" %></title>
</head>
<body> 
    <%- include("./partials/navbar") %>

    <main>
        <h1><%= currentFolder ? currentFolder.name : "Root" %></h1>
        <div id="folder-header">
            <%# Only show back button for items that are not root folder%>
            <% if (locals.currentFolder && currentFolder.id !== share.folderId) {%>
                <a href="/share/<%= share.token %><%= currentFolder.parentId !== locals.share.folderId ? `/folder/${currentFolder.parentId}` : ""%>">Back</a>
            <% } %>   
        </div>

        <%- include("./partials/shareBrowser")>
    </main>
</body>
</html>