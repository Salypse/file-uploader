<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= file.name %></title>
</head>
<body>
    <a href="/">Home</a>
    <main>
        <a href="<%= locals.file.parentId ? `/folder/${locals.file.parentId}` : "/"%>">Back</a>

        <div id="file-info">
            <strong><%= file.name %></strong>
            <p>Uploaded On: <%= file.createdAt %></p>
            <p>File Size: <%= file.fileSize %> </p>
        </div>
        <div id="file-options">
            <form action="/file/download/<%= file.path %>" method="GET">
              <button type="submit">Download</button>
            </form>

            <button 
                type="button" 
                data-target="delete-content" 
                data-content-id="<%= file.id%>" 
                data-content-name="<%= file.name %>"
                data-type="file"
                data-file-path="<%= file.path %>"
                class="open-modal delete-content-btn"
            > Delete </button>
        </div>
    </main>
</body>

<script src="/utils/dialogs/dialog.js" defer></script>
<script src="/utils/dialogs/deleteContent.js" defer></script>
<%- include("./partials/dialogs/deleteContent") %>
</html>