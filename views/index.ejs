<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Template</title>
    <link rel="stylesheet" href="/styles/index.css" />
  </head>

  <body>
    <main>
      <% if (locals.user) { %>
        <p><%= user.username %>, You are logged in.</p>
        <a href="/login/log-out">Logout</a>
      <% } else {%>
        <p>You are not logged in.</p>
        <a href="/login">Login</a>
        <a href="/sign-up">Sign Up</a>
      <% } %>

      <% if (locals.user) { %>
        <%- include("partials/errors") %>

        <section id="file-browser">
          <button type="button" data-target="new-folder" class="open-modal">New Folder +</button>

          <% if (locals.folders.length) {%>
            <div>
              <h2>Files</h2>
              <ul>
                <% folders.forEach((folder) => { %>
                <li>
                  <a href="/folder/<%= folder.id %>"><%= folder.name %></a>

                  <button type="button" data-target="delete-folder" data-folder-id="<%= folder.id%>" data-folder-name="<%= folder.name %>" class="open-modal delete-folder-btn"> X </button>
                </li>
                <% }) %>
              </ul>
            </div>
          <%}%>
        </section>

        <%- include("partials/dialogGroups/indexDialogs.ejs") %>
      <% } %>
    </main>
  </body>
</html>