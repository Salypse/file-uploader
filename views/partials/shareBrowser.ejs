<section id="share-browser">
    <div id="content">
        <% content.forEach((item) => { %>   
            <% if (item.type === "folder") {%>
                <%# Share Folder HTML %>

                <a href="/share/<%= share.token %>/folder/<%= item.id %>"><%= item.name %></a>
            <% } else if (item.type === "file") {%>
                <%# Share File HTML%>

                <a href="/share/<%= share.token %>/file/<%= item.id%>"><%= item.name%></a>

                <div id="file-options">
                    <form action="/share/<%= share.token %>/download/<%= item.id %>" method="GET">
                        <button type="submit">Download</button>
                    </form>
                </div>
            <% } %>
        <% })%>
    </div>
    
</section>
         