<section id="share-browser">
    <% if (content.folders.length > 0) { %>
        <section id="folder-content">
            <h2>Folders</h2>

            <% content.folders.forEach((folder) => {%>
                <%# Share Folder HTML%>
                <div class="folder">
                    <a href="/share/<%= share.token %>/folder/<%= folder.id%>"><%= folder.name %></a>
                </div>
            <% }) %>
        </section>
    <% } %>

    <% if (content.files.length > 0) { %>
        <section id="file-content">
            <h2>Files</h2>

            <% content.files.forEach((file) => {%>
                <%# Share File HTML%>
                <div class="file">
                    <a href="/share/<%= share.token %>/file/<%= file.id%>"><%= file.name %></a>

                    <form action="/share/<%= share.token %>/download/<%= file.id%>" method="GET">
                        <button type="submit">Download</button>
                    </form>
                </div>
            <% }) %>
        </section>
    <% } %>

</section>
         