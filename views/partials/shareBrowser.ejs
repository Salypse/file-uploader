<section id="share-browser">
    <h1><%= currentFolder ? currentFolder.name : "Root" %></h1>

    <div id="content">
        <% content.forEach((item) => { %>   
            <% if (item.type === "folder") {%>
                <%# Share Folder HTML %>

                <a href="/share/<%= token %>/folder/<%= item.id %>"><%= item.name %></a>
            <% } %>
        <% })%>
    </div>
    
</section>
         