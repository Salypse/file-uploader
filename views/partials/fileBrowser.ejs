<section id="file-browser">
    <button type="button" data-target="new-folder" class="open-modal">New Folder +</button>

    <form action="<%= locals.folder ? `/file/${folder.id}` : "/file" %>" method="post" enctype="multipart/form-data">
      <label for="upload_files">Upload Files</label>
      <input type="file" id="upload_files" name="uploadFiles" multiple required />

      <button type="submit">Upload</button>
    </form>

    <% if (locals.content.length) {%>
        <section id="content">
          <% content.forEach((item) => { %>
            <div>
              <% if (item.type === "folder") { %>
                <%# Folder HTML %>

                <a href="/folder/<%= item.id %>"><%= item.name %></a>

                <button 
                    type="button"
                    data-target="update-folder"
                    data-folder-id="<%= item.id%>" 
                    data-folder-name="<%= item.name %>"
                    class="open-modal update-folder-btn"
                  > Rename </button>

                  <button 
                    type="button" 
                    data-target="delete-folder" 
                    data-folder-id="<%= item.id%>" 
                    data-folder-name="<%= item.name %>" 
                    class="open-modal delete-folder-btn"
                  > X </button>
              <% } else if (item.type === "file") { %>
                <%# File HTML%>

                <strong><%= item.name %></strong>
              <% } %>
            </div>
          <% })%>
        </section>
    <%}%>

    <%- include("./dialogGroups/folderDialogs.ejs") %>
</section>