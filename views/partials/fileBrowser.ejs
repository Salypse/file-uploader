<section id="files">
    <button type="button" data-target="new-folder" class="open-modal">New Folder +</button>

    <% if (locals.content?.length > 0) {%>
      <a href="/share/create<%= locals.folder ? `/${folder.id}` : "" %>">Share</a>
    <% } %>

    <form action="<%= locals.folder ? `/file/${folder.id}` : "/file" %>" method="post" enctype="multipart/form-data">
      <label for="upload_files">Upload Files</label>
      <input type="file" id="upload_files" name="uploadFiles" multiple required />

      <button type="submit">Upload</button>
    </form>

    <% if (locals.errors?.length > 0) { %>
      <%- include ("./errors")%>
    <% } %>

    <% if (locals.content.length) {%>
        <section id="file-browser">
          <% content.forEach((item) => { %>
            <div id="content">
              <% if (item.type === "folder") { %>
                <%# Folder HTML %>

                <a href="/folder/<%= item.id %>"><%= item.name %></a>

                <button 
                    type="button"
                    data-target="update-name"
                    data-content-id="<%= item.id%>" 
                    data-content-name="<%= item.name %>"
                    data-type="folder"
                    class="open-modal update-name-btn"
                  > Rename </button>

                  <button 
                    type="button" 
                    data-target="delete-content" 
                    data-content-id="<%= item.id%>" 
                    data-content-name="<%= item.name %>"
                    data-type="folder"
                    class="open-modal delete-content-btn"
                  > X </button>
              <% } else if (item.type === "file") { %>
                <%# File HTML%> 

                <a href="/file/<%= item.id %>"><%= item.name %></a>

                <form action="/file/download/<%= item.id %>" method="GET">
                  <button type="submit">Download</button>
                </form>

                <button 
                    type="button" 
                    data-target="delete-content" 
                    data-content-id="<%= item.id%>" 
                    data-content-name="<%= item.name %>"
                    data-type="file"
                    data-file-path="<%= item.path %>"
                    class="open-modal delete-content-btn"
                  > X </button>
              <% } %>
            </div>
          <% })%>
        </section>
    <%} else {%>
      <p>No items in this folder.</p>
    <% }%>

    <%- include("./dialogGroups/contentDialogs.ejs") %>
</section>