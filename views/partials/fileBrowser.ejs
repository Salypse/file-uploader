<section id="files">
    <button type="button" data-target="new-folder" class="open-modal">New Folder +</button>

    <a href="/share/create<%= locals.folder ? `/${folder.id}` : "" %>">Share</a>

    <form action="<%= locals.folder ? `/file/${folder.id}` : "/file" %>" method="post" enctype="multipart/form-data">
      <label for="upload_files">Upload Files</label>
      <input type="file" id="upload_files" name="uploadFiles" multiple required />

      <button type="submit">Upload</button>
    </form>

    <% if (locals.errors?.length > 0) { %>
      <%- include ("./errors")%>
    <% } %>

        <section id="file-browser">
          <% if (content.folders.length > 0) { %>
            <section id="folder-content">
              <h2>Folders</h2>
              <% content.folders.forEach((folder) => {%>
                <%# Folder HTML %>
                <div class="folder" >
                  <a href="/folder/<%= folder.id %>"><%= folder.name %></a>  

                  <button 
                    type="button"
                    data-target="update-name"
                    data-content-id="<%= folder.id%>" 
                    data-content-name="<%= folder.name %>"
                    data-type="folder"
                    class="open-modal update-name-btn"
                  > Rename </button>

                  <button 
                    type="button" 
                    data-target="delete-content" 
                    data-content-id="<%= folder.id%>" 
                    data-content-name="<%= folder.name %>"
                    data-type="folder"
                    class="open-modal delete-content-btn"
                  > X </button>
                </div>
              <% }) %>
            </section>
          <% } %>

          <% if (content.files.length > 0) {%>
            <section id="file-content">
              <h2>Files</h2>
              <% content.files.forEach((file) => {%>
                <%## File HTML%>
                <div class="file">
                  <a href="/file/<%= file.id %>"><%= file.name %></a>

                  <form action="/file/download/<%= file.id %>" method="GET">
                    <button type="submit">Download</button>
                  </form>

                  <button 
                    type="button"
                    data-target="delete-content"
                    data-content-id="<%= file.id%>"
                    data-content-name="<%= file.name %>""
                    data-type="file"
                    data-file-path="<%= file.path %>""
                    class="open-modal delete-content-btn"
                  > X </button> %>
                </div>
              <% }) %>
            </section>
          <% } %>
        </section>
    <%- include("./dialogGroups/contentDialogs.ejs") %>
</section>