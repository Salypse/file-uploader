<% if (locals.errors?.length > 0) { %>
  <%- include ("./errors")%>
<% } %>

<section id="file-browser" class="browser">
  <div id="browser-options">
    <div id="folder-options">
      <button type="button" data-target="new-folder" class="open-modal browser-options-btn">New Folder +</button>
      <a href="/share/create<%= locals.folder ? `/${folder.id}` : "" %>" class="browser-options-btn">
        Share
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share"><path d="M12 2v13"/><path d="m16 6-4-4-4 4"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/></svg>
      </a>
    </div>

    <form action="<%= locals.folder ? `/file/${folder.id}` : "/file" %>" method="post" enctype="multipart/form-data">
      <input type="file" id="upload-files" name="uploadFiles" multiple required />
      <label for="upload-files"  class="browser-options-btn"><strong>Choose Files</strong></label>

      <button type="submit" class="browser-options-btn">Upload</button>
    </form>
  </div>

  <% if (content.folders.length > 0) { %>
    <section id="folder-content" class="browser-section">
      <h2>Folders</h2>

      <% content.folders.forEach((folder) => {%>
        <%# Folder HTML %>
        <div class="folder item">
          <a href="/folder/<%= folder.id %>">
            <span aria-hidden="true">📁</span> 
            <%= folder.name %>
          </a>  

          <div class="item-options">
            <button 
              type="button"
              data-target="update-name"
              data-content-id="<%= folder.id%>" 
              data-content-name="<%= folder.name %>"
              data-type="folder"
              class="open-modal update-name-btn"
              aria-label="Rename <%= folder.name %>"
            > 
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/></svg> 
            </button>

            <button 
              type="button" 
              data-target="delete-content" 
              data-content-id="<%= folder.id%>" 
              data-content-name="<%= folder.name %>"
              data-type="folder"
              class="open-modal delete-content-btn"
              aria-label="Delete <%= folder.name %>"
            > 
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        </div>
      <% }) %>
    </section>
  <% } %>

  <% if (content.files.length > 0) {%>
    <section id="file-content" class="browser-section">
      <h2>Files</h2>

      <% content.files.forEach((file) => {%>
        <%## File HTML%>
        <div class="file item">
          <a href="/file/<%= file.id %>">
            <span aria-hidden="true">💾</span> 
            <%= file.name %>
          </a>

          <div class="item-options">
            <form action="/file/download/<%= file.id %>" method="GET">
              <button type="submit" aria-label="Download <%= file.name %>">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down-to-line"><path d="M12 17V3"/><path d="m6 11 6 6 6-6"/><path d="M19 21H5"/></svg>
              </button>
            </form>

            <button 
              type="button"
              data-target="delete-content"
              data-content-id="<%= file.id%>"
              data-content-name="<%= file.name %>"
              data-type="file"
              data-file-path="<%= file.path %>"
              class="open-modal delete-content-btn"
              aria-label="Delete <%= file.name %>"
              > 
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        </div>
      <% }) %>
    </section>
  <% } %>

  <% if (content.folders.length === 0 && content.files.length === 0) {%>
    <strong id="no-content">No content at this location.</strong>
  <% } %>
</section>

<%- include("./dialogGroups/contentDialogs.ejs") %>
<script src="/utils/fileInput.js" defer></script>
