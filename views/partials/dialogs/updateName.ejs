<dialog class="modal" id="update-name">
    <button class="close-modal">X</button>

    <h2 id="update-name-header">Rename <%= dialog?.item.type[0].toUpperCase() + dialog?.item.type.slice(1) %></h2>

    <% if (locals.dialog?.name === "update-name" && locals.dialog?.errors?.length > 0) {%>
        <%- include("../errors") %>
    <% } %>

    <form action="/<%= dialog?.item.type %>/<%= dialog?.item.id || ""%>?_method=PATCH" method="POST"  id="update-form">
        <p id="action-text"></p>
        <label for="update-mame-input">Name</label>
        <input type="text" id="update-name-input" name="contentName" value="<%= dialog?.item.name || ""%>">

        <button type="submit">Save</button>
    </form>
</dialog>