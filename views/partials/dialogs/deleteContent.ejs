<dialog class="modal" id="delete-content">
  <div class="modal-header">
    <h2 id="delete-header"></h2>
    <button class="close-modal">X</button>
  </div>
  
  <p id="delete-message"></p>

  <form id="delete-form" method="POST">
    <input type="hidden" id="file-path" name="filePath">
    <input type="hidden" id="file-id" name="fileId">

    <button type="submit" class="modal-action-btn">Delete</button>
  </form>
</dialog>
