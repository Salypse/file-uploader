<dialog class="modal" id="new-folder">
  <button class="close-modal" data-target="new-folder">X</button>

  <h2>New Folder</h2>
  <form action="/folder" method="POST">
    <label for="folder-name">Name</label>
    <input type="text" id="folder-name" name="folderName" />

    <button type="submit">Create</button>
  </form>
</dialog>
