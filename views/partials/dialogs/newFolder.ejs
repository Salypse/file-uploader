<dialog class="modal" id="new-folder" aria-labelledby="new-folder-header">
  <div class="modal-header">
    <h2 id="new-folder-header">New Folder</h2>
    <button type="button" class="close-modal" aria-label="close">X</button>
  </div>

  <% if (locals.dialog?.item.type === "folder" && locals.dialog?.name === "new-folder") {%>
    <%- include("../errors") %>
  <% } %>

  <form action="<%= locals.folder ? `/folder/${folder.id}` : "/folder" %>" method=POST>
    <div>
      <label for="folder-name">Name</label>
      <input type="text" id="folder-name" name="contentName" />
    </div>

    <button type="submit" class="modal-action-btn">Create</button>
  </form>
</dialog>
