<dialog class="modal" id="update-content">
    <button class="close-modal">X</button>

    <h2>Rename</h2>

    <%- include("../errors") %>

    <form action="/folder/<%= updateFolder?.id || ""%>?_method=PATCH" method="POST"  id="update-form">
        <p id="action-text"></p>
        <label for="update-content-name">Name</label>
        <input type="text" id="update-content-name" name="folderName" value="<%= updateFolder?.name || ""%>">

        <button type="submit">Save</button>
    </form>
</dialog>