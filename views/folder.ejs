<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= folder.name %></title>
  </head>
  <body>
    <a href="/">Home</a>
    <main>
    <button type="button" data-target="new-folder" class="open-modal">New Folder +</button>
      <div id="folder-header">
        <a href="<%= locals.folder.parentId ? `/folder/${locals.folder.parentId}` : "/"%>">Back</a>
        <h1><%= folder.name %></h1>

        <button 
          type="button"
          data-target="update-name"
          data-content-id="<%= folder.id%>" 
          data-content-name="<%= folder.name %>"
          data-type="folder"
          class="open-modal update-name-btn"
        > Rename </button>

        <button 
          type="button" 
          data-target="delete-content" 
          data-content-id="<%= folder.id%>" 
          data-content-name="<%= folder.name %>"
          data-type="folder"
          class="open-modal delete-content-btn"
        > X </button>
      </div>

      <%- include("./partials/fileBrowser") %>
    </main>
  </body>
</html>
