generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  folders  Folder[]
  files    File[]
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  parentId  Int?
  createdAt DateTime @default(now())

  parentFolder Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  folders      Folder[] @relation("FolderTree")
  files        File[]
}

model File {
  id        Int      @id @default(autoincrement())
  name      String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  path      String
  parentId  Int?
  createdAt DateTime @default(now())

  parentFolder Folder? @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
